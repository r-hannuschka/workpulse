{
  "name": "workpulse",
  "publisher": "trueffelmafia",
  "displayName": "Workpulse",
  "engines": {
    "vscode": "^1.105.0"
  },
  "version": "0.0.0",
  "description": "Timetracker fuer Jira Issues",
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "./dist/workpulse.js",
  "contributes": {
    "commands": [
      {
        "command": "workpulse.openWebview",
        "title": "Workpulse: open webview"
      }
    ],
    "configuration": {
      "properties": {
        "workpulse.JIRA_API_URL": {
          "type": "string",
          "default": "",
          "description": "Jira Restapi URL"
        },
        "workpulse.JIRA_API_TOKEN": {
          "type": "string",
          "default": "",
          "description": "Jira API Token"
        },
        "workpulse.JIRA_USER_NAME": {
          "type": "string",
          "default": "",
          "description": "Jira Benutzername/Email"
        },
        "workpulse.JIRA_PROJECT_KEY": {
          "type": "string",
          "default": "",
          "description": "Jira Project Key"
        },
        "workpulse.ISSUE_TYPE_MAPPING": {
          "type": "object",
          "title": "Ticket-Typen Mapping",
          "description": "Füge den Namen aus deinem Jira hinzu (Links) und wähle den internen Typ (Rechts).",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "BUG",
              "FEATURE"
            ]
          },
          "default": {
            "Fehler": "BUG",
            "Bug": "BUG",
            "Unteraufgabe Fehler": "BUG",
            "Unteraufgabe": "FEATURE",
            "Aufgabe": "FEATURE",
            "Story": "FEATURE"
          }
        },
        "workpulse.STATUS_MAPPING": {
          "type": "object",
          "title": "Status Mapping",
          "description": "Füge den Status-Namen aus deinem Jira hinzu (Links) und wähle den internen Zustand (Rechts).",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "TO_DO",
              "IN_PROGRESS",
              "TEST",
              "DONE"
            ]
          },
          "default": {
            "To Do": "TO_DO",
            "Offen": "TO_DO",
            "Erfasst": "TO_DO",
            "Backlog / Neu": "TO_DO",
            "AD - In Bearbeitung": "IN_PROGRESS",
            "In Bearbeitung": "IN_PROGRESS",
            "In Entwicklung": "IN_PROGRESS",
            "In Progress": "IN_PROGRESS",
            "Im Test": "TEST",
            "Bereit für Test": "TEST",
            "Fertig": "DONE",
            "Abgeschlossen": "DONE"
          }
        }
      }
    }
  },
  "enabledApiProposals": [
    "extensionRuntime"
  ],
  "scripts": {
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
    "watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "reflect-metadata": "0.2.2",
    "tsyringe": "4.10.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "26.6.3",
    "@types/vscode": "1.138.0",
    "@workpulse/api": "file:../api",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-commonjs": "^0.10.4"
  }
}
